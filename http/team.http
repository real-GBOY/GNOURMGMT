@host = http://localhost:4005/api/teams
@id = 689366601f511e23969424db
### Create a new team
POST {{host}}
Content-Type: application/json

{
  "name": "mohsen Team",
  "description": "Handles all product development"
}

### Get all teams

GET {{host}}
